# Server Port
PORT=5000

# MongoDB Atlas Connection URI
# Replace <username> and <password> with your MongoDB Atlas database credentials
# Example: mongodb+srv://admin:myStrongPassword123@cluster0.abcde.mongodb.net/crimevision?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/crimevision?retryWrites=true&w=majority

# JWT Secret Key for Authentication
JWT_SECRET=crimevision_secret_jwt_key_super_secure_2026

# JWT Expiration
JWT_EXPIRES_IN=7d

# Python AI Inference Service URL (optional if running FastAPI on port 8000)
AI_SERVICE_URL=http://localhost:8000
